{
  "name": "@game-reels/api",
  "version": "0.1.0",
  "private": true,
  "description": "Game Reels API: catalogue, feed, plays, events and guest identities",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "nest build",
    "start": "node --env-file=.env.production dist/main.js",
    "dev": "nest start --watch",
    "dev:local": "tsx scripts/dev-local.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"prisma/**/*.ts\"",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "publish-game": "tsx scripts/publish-game.ts",
    "set-game-version": "tsx scripts/set-game-version.ts",
    "release:withdraw": "tsx scripts/release.ts withdraw",
    "release:restore": "tsx scripts/release.ts restore",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e.config.js --runInBand",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@fastify/static": "10.1.7",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "fastify": "5.11.3",
    "mime-types": "3.0.2",
    "mysql2": "^3.24.6",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@testcontainers/mysql": "12.2.1",
    "@types/jest": "30.0.0",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "mysql-memory-server": "1.17.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
