generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Player {
  id         String      @id @default(uuid())
  kind       PlayerKind  @default(GUEST) // GUEST now, REGISTERED later
  deviceId   String      @unique
  createdAt  DateTime    @default(now())
  lastSeenAt DateTime    @default(now())
  plays      Play[]
  events     Event[]
  bests      BestScore[]
}

enum PlayerKind {
  GUEST
  REGISTERED
}

model Game {
  id               String        @id // "stack"
  name             String
  description      String        @db.Text
  // JSON arrays: MySQL has no array columns.
  tags             Json // ["timing", "one-tap"]
  controls         Json // ["tap"] | ["drag-x"]
  avgRoundSeconds  Int
  status           GameStatus    @default(DRAFT)
  currentVersion   GameVersion?  @relation("current", fields: [currentVersionId], references: [id])
  currentVersionId String?       @unique
  versions         GameVersion[] @relation("versions")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
}

enum GameStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

model GameVersion {
  id             String   @id @default(uuid())
  gameId         String
  game           Game     @relation("versions", fields: [gameId], references: [id])
  version        String // semver "1.2.0"
  bundleUrl      String   @db.VarChar(512)
  thumbnailUrl   String   @db.VarChar(512)
  sizeBytes      Int
  sdkVersion     Int
  minAppVersion  String
  maxScorePerSec Float // used by ScoreValidator
  createdAt      DateTime @default(now())
  currentFor     Game?    @relation("current")

  @@unique([gameId, version])
}

model Play {
  id          String   @id @default(uuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id])
  gameId      String
  gameVersion String
  score       Int
  durationMs  Int
  seed        Int?
  flagged     Boolean  @default(false) // failed plausibility check
  createdAt   DateTime @default(now())

  @@index([gameId, score])
  @@index([playerId, createdAt])
}

model BestScore {
  playerId  String
  gameId    String
  score     Int
  updatedAt DateTime @updatedAt
  player    Player   @relation(fields: [playerId], references: [id])

  @@id([playerId, gameId])
}

// An installable app build, saved from the EAS build webhook. The download website serves the
// newest one that is not withdrawn.
model AppRelease {
  id           String   @id @default(uuid())
  easBuildId   String   @unique
  platform     String // "android"
  buildProfile String // "staging"
  version      String // "1.0.3"
  buildNumber  String // android versionCode
  apkUrl       String   @db.VarChar(1024) // on EAS; expires after EAS's retention period
  buildPageUrl String?  @db.VarChar(512)
  gitCommit    String?
  mirroredFile String? // copy under APK_DIR, served at /apk/<file>
  withdrawn    Boolean  @default(false) // set true to roll back past a bad build
  completedAt  DateTime
  createdAt    DateTime @default(now())

  @@index([platform, withdrawn, completedAt])
}

model Event {
  id        BigInt   @id @default(autoincrement())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  type      String // game_view, game_skip, ...
  gameId    String?
  props     Json
  clientTs  DateTime
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([gameId, type])
}
